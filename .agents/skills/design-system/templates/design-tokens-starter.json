{
    "$schema": "https://design-tokens.org/schema.json",
    "component": {
        "button": {
            "bg": { "$type": "color", "$value": "{semantic.color.primary}" },
            "fg": {
                "$type": "color",
                "$value": "{semantic.color.primary-foreground}"
            },
            "font-size": {
                "$type": "dimension",
                "$value": "{primitive.fontSize.sm}"
            },
            "hover-bg": {
                "$type": "color",
                "$value": "{semantic.color.primary-hover}"
            },
            "padding-x": {
                "$type": "dimension",
                "$value": "{primitive.spacing.4}"
            },
            "padding-y": {
                "$type": "dimension",
                "$value": "{primitive.spacing.2}"
            },
            "radius": {
                "$type": "dimension",
                "$value": "{primitive.radius.md}"
            }
        },
        "card": {
            "bg": { "$type": "color", "$value": "{primitive.color.white}" },
            "border": { "$type": "color", "$value": "{semantic.color.border}" },
            "padding": {
                "$type": "dimension",
                "$value": "{primitive.spacing.6}"
            },
            "radius": {
                "$type": "dimension",
                "$value": "{primitive.radius.lg}"
            },
            "shadow": {
                "$type": "shadow",
                "$value": "{primitive.shadow.default}"
            }
        },
        "input": {
            "bg": { "$type": "color", "$value": "{semantic.color.background}" },
            "border": { "$type": "color", "$value": "{semantic.color.border}" },
            "focus-ring": {
                "$type": "color",
                "$value": "{semantic.color.ring}"
            },
            "padding-x": {
                "$type": "dimension",
                "$value": "{primitive.spacing.3}"
            },
            "padding-y": {
                "$type": "dimension",
                "$value": "{primitive.spacing.2}"
            },
            "radius": {
                "$type": "dimension",
                "$value": "{primitive.radius.md}"
            }
        }
    },
    "dark": {
        "semantic": {
            "color": {
                "background": {
                    "$type": "color",
                    "$value": "{primitive.color.gray.950}"
                },
                "border": {
                    "$type": "color",
                    "$value": "{primitive.color.gray.800}"
                },
                "foreground": {
                    "$type": "color",
                    "$value": "{primitive.color.gray.50}"
                },
                "muted": {
                    "$type": "color",
                    "$value": "{primitive.color.gray.800}"
                },
                "muted-foreground": {
                    "$type": "color",
                    "$value": "{primitive.color.gray.400}"
                },
                "secondary": {
                    "$type": "color",
                    "$value": "{primitive.color.gray.800}"
                }
            }
        }
    },
    "primitive": {
        "color": {
            "blue": {
                "50": { "$type": "color", "$value": "#EFF6FF" },
                "500": { "$type": "color", "$value": "#3B82F6" },
                "600": { "$type": "color", "$value": "#2563EB" },
                "700": { "$type": "color", "$value": "#1D4ED8" },
                "800": { "$type": "color", "$value": "#1E40AF" }
            },
            "gray": {
                "100": { "$type": "color", "$value": "#F3F4F6" },
                "200": { "$type": "color", "$value": "#E5E7EB" },
                "300": { "$type": "color", "$value": "#D1D5DB" },
                "400": { "$type": "color", "$value": "#9CA3AF" },
                "50": { "$type": "color", "$value": "#F9FAFB" },
                "500": { "$type": "color", "$value": "#6B7280" },
                "600": { "$type": "color", "$value": "#4B5563" },
                "700": { "$type": "color", "$value": "#374151" },
                "800": { "$type": "color", "$value": "#1F2937" },
                "900": { "$type": "color", "$value": "#111827" },
                "950": { "$type": "color", "$value": "#030712" }
            },
            "green": {
                "500": { "$type": "color", "$value": "#22C55E" },
                "600": { "$type": "color", "$value": "#16A34A" }
            },
            "red": {
                "500": { "$type": "color", "$value": "#EF4444" },
                "600": { "$type": "color", "$value": "#DC2626" },
                "700": { "$type": "color", "$value": "#B91C1C" }
            },
            "white": { "$type": "color", "$value": "#FFFFFF" },
            "yellow": {
                "500": { "$type": "color", "$value": "#EAB308" }
            }
        },
        "duration": {
            "fast": { "$type": "duration", "$value": "150ms" },
            "normal": { "$type": "duration", "$value": "200ms" },
            "slow": { "$type": "duration", "$value": "300ms" }
        },
        "fontSize": {
            "2xl": { "$type": "dimension", "$value": "1.5rem" },
            "3xl": { "$type": "dimension", "$value": "1.875rem" },
            "4xl": { "$type": "dimension", "$value": "2.25rem" },
            "base": { "$type": "dimension", "$value": "1rem" },
            "lg": { "$type": "dimension", "$value": "1.125rem" },
            "sm": { "$type": "dimension", "$value": "0.875rem" },
            "xl": { "$type": "dimension", "$value": "1.25rem" },
            "xs": { "$type": "dimension", "$value": "0.75rem" }
        },
        "radius": {
            "default": { "$type": "dimension", "$value": "0.25rem" },
            "full": { "$type": "dimension", "$value": "9999px" },
            "lg": { "$type": "dimension", "$value": "0.5rem" },
            "md": { "$type": "dimension", "$value": "0.375rem" },
            "none": { "$type": "dimension", "$value": "0" },
            "sm": { "$type": "dimension", "$value": "0.125rem" },
            "xl": { "$type": "dimension", "$value": "0.75rem" }
        },
        "shadow": {
            "default": {
                "$type": "shadow",
                "$value": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)"
            },
            "lg": {
                "$type": "shadow",
                "$value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
            },
            "md": {
                "$type": "shadow",
                "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)"
            },
            "none": { "$type": "shadow", "$value": "none" },
            "sm": {
                "$type": "shadow",
                "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)"
            }
        },
        "spacing": {
            "0": { "$type": "dimension", "$value": "0" },
            "1": { "$type": "dimension", "$value": "0.25rem" },
            "10": { "$type": "dimension", "$value": "2.5rem" },
            "12": { "$type": "dimension", "$value": "3rem" },
            "16": { "$type": "dimension", "$value": "4rem" },
            "2": { "$type": "dimension", "$value": "0.5rem" },
            "3": { "$type": "dimension", "$value": "0.75rem" },
            "4": { "$type": "dimension", "$value": "1rem" },
            "5": { "$type": "dimension", "$value": "1.25rem" },
            "6": { "$type": "dimension", "$value": "1.5rem" },
            "8": { "$type": "dimension", "$value": "2rem" }
        }
    },
    "semantic": {
        "color": {
            "background": {
                "$type": "color",
                "$value": "{primitive.color.gray.50}"
            },
            "border": {
                "$type": "color",
                "$value": "{primitive.color.gray.200}"
            },
            "destructive": {
                "$type": "color",
                "$value": "{primitive.color.red.600}"
            },
            "destructive-foreground": {
                "$type": "color",
                "$value": "{primitive.color.white}"
            },
            "foreground": {
                "$type": "color",
                "$value": "{primitive.color.gray.900}"
            },
            "muted": {
                "$type": "color",
                "$value": "{primitive.color.gray.100}"
            },
            "muted-foreground": {
                "$type": "color",
                "$value": "{primitive.color.gray.500}"
            },
            "primary": {
                "$type": "color",
                "$value": "{primitive.color.blue.600}"
            },
            "primary-foreground": {
                "$type": "color",
                "$value": "{primitive.color.white}"
            },
            "primary-hover": {
                "$type": "color",
                "$value": "{primitive.color.blue.700}"
            },
            "ring": {
                "$type": "color",
                "$value": "{primitive.color.blue.500}"
            },
            "secondary": {
                "$type": "color",
                "$value": "{primitive.color.gray.100}"
            },
            "secondary-foreground": {
                "$type": "color",
                "$value": "{primitive.color.gray.900}"
            }
        },
        "spacing": {
            "component": {
                "$type": "dimension",
                "$value": "{primitive.spacing.4}"
            },
            "section": {
                "$type": "dimension",
                "$value": "{primitive.spacing.12}"
            }
        }
    }
}
